{
  "name": "@bilcode/api",
  "private": true,
  "scripts": {
    "dev": "npm run build && concurrently -k -n TSC,API \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "npm run build && node --test --test-concurrency=1 test/integration.test.mjs",
    "setup": "node scripts/setup.mjs",
    "format": "prettier --write \"src/*.ts\" \"test/*.mjs\" \"scripts/*.mjs\""
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "prettier": "^3.6.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "prisma": "^7.10.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24.0"
  }
}
