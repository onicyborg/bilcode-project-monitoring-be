generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model AdminRefreshSession {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  revokedAt DateTime?
  updatedAt DateTime  @updatedAt
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

model Configuration {
  id                    String   @id @default("main")
  intervalSeconds       Int      @default(300)
  phone                 String   @default("6281347890520")
  gowaUrl               String   @default("https://wa.geats.web.id")
  gowaUsername          String   @default("geats")
  gowaPasswordEncrypted String?
  deviceId              String   @default("personal")
  authAlerts            Boolean  @default(true)
  autoBid               Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

model BilcodeSession {
  id                    String    @id @default("main")
  refreshTokenEncrypted String?
  authStatus            String    @default("MISSING")
  importedAt            DateTime?
  validatedAt           DateTime?
  refreshedAt           DateTime?
  lastError             String?
}

model MonitorState {
  id             String    @id @default("main")
  desiredRunning Boolean   @default(false)
  lastCheckAt    DateTime?
  lastSuccessAt  DateTime?
  nextCheckAt    DateTime?
  lastError      String?
  authAlerted    Boolean   @default(false)
  gowaConnected  Boolean?
  gowaCheckedAt  DateTime?
}

model CheckRun {
  id          String    @id @default(uuid())
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("RUNNING")
  durationMs  Int?
  available   Int       @default(0)
  newProjects Int       @default(0)
  sent        Int       @default(0)
  error       String?

  @@index([startedAt(sort: Desc)])
}

model Notification {
  id         String    @id @default(uuid())
  projectKey String    @unique
  payload    Json
  parts      Json
  nextPart   Int       @default(0)
  status     String    @default("PENDING")
  attempts   Int       @default(0)
  lastError  String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  @@index([createdAt(sort: Desc)])
}

model EventLog {
  id         String   @id @default(uuid())
  category   String
  level      String   @default("INFO")
  action     String
  message    String
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([category, createdAt(sort: Desc)])
}

model BidProject {
  projectId  Int      @id
  title      String
  payload    Json
  available  Boolean  @default(true)
  hasApplied Boolean  @default(false)
  observedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BidApplication {
  id              String           @id @default(uuid())
  projectId       Int              @unique
  title           String
  upstreamId      Int?             @unique
  state           String
  source          String           @default("MANUAL")
  status          String?
  proposalPayload Json?
  lastError       String?
  confirmedAt     DateTime?
  submittedAt     DateTime         @default(now())
  lastSyncedAt    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  events          BidStatusEvent[]
  attempts        BidAttempt[]

  @@index([submittedAt, id])
}

model BidDraft {
  projectId       Int      @id
  version         String
  state           String
  isDevelopment   Boolean  @default(false)
  reason          String?
  proposalPayload Json?
  lastError       String?
  autoAttempted   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BidAttempt {
  id             String         @id @default(uuid())
  applicationId  String
  application    BidApplication @relation(fields: [applicationId], references: [id])
  outcome        String
  phase          String
  httpStatus     Int?
  postHttpStatus Int?
  code           String?
  message        String
  action         String
  response       Json?
  createdAt      DateTime       @default(now())

  @@index([applicationId, createdAt])
}

model BidStatusEvent {
  id             String         @id @default(uuid())
  applicationId  String
  application    BidApplication @relation(fields: [applicationId], references: [id])
  previousStatus String?
  nextStatus     String
  parts          Json
  nextPart       Int            @default(0)
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime       @default(now())

  @@index([sentAt, createdAt])
}

model BidSyncState {
  id           String    @id @default("main")
  lastSyncedAt DateTime?
  lastError    String?
}
